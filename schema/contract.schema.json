{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcap.dev/schema/v1/contract.schema.json",
  "title": "AgentCap CapabilityContract",
  "description": "A signed, short-lived grant of authority to an agent. Absence of a valid contract means the agent may call nothing.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentcap.dev/v1" },
    "kind": { "const": "CapabilityContract" },
    "metadata": {
      "type": "object",
      "required": ["name", "principal", "issued", "expires"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "description": "Stable contract identifier, used for revocation."
        },
        "principal": {
          "type": "string",
          "description": "The accountable human or team. A contract without a named principal is invalid."
        },
        "issued": { "type": "string", "format": "date-time" },
        "expires": {
          "type": "string",
          "format": "date-time",
          "description": "Hard expiry. Short by default; the mediator denies on expiry."
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["identity", "tools"],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "object",
          "required": ["workload"],
          "additionalProperties": false,
          "properties": {
            "workload": {
              "type": "string",
              "description": "SPIFFE ID, OIDC subject, or other workload identity anchor."
            },
            "awsRole": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDepth": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "How many further hops may carry this authority. 0 means the agent may not delegate."
            },
            "nonDelegable": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Capability patterns that terminate at this hop.",
              "default": []
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "description": "The allowlist. Tools not listed here are denied.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Canonical tool identifier, e.g. mcp://github/list_issues or aws:s3:PutObject."
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$",
                "description": "Pinned hash of the tool definition. A mismatch is a deny: the tool that changed is not the tool that was approved."
              },
              "allow": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requireApproval": {
                "type": "boolean",
                "default": false,
                "description": "Requires an out-of-band human decision the agent cannot satisfy itself."
              },
              "maxCalls": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "arguments": {
          "type": "array",
          "description": "Argument predicates. A tool with a pinned digest but no predicate is still bounded by the tool's own contract.",
          "items": {
            "type": "object",
            "required": ["tool", "constraint"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string" },
              "constraint": {
                "type": "string",
                "description": "A deterministic predicate over the call arguments. 'false' denies the tool outright."
              }
            }
          }
        },
        "dataFlow": {
          "type": "array",
          "description": "Taint rules. Values derived from a labelled source may not reach a listed sink.",
          "items": {
            "type": "object",
            "required": ["from", "deny"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "description": "Taint label, e.g. untrusted:web" },
              "deny": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Sink patterns that may not receive data from this source."
              }
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usd": { "type": "number", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "egressGiB": { "type": "number", "minimum": 0 }
          }
        },
        "policyHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Binds this contract to the exact policy compiler output in force when it was issued."
        }
      }
    }
  }
}
